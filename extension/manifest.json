{
  "manifest_version": 3,
  "name": "StudySync Focus & Screen Time Companion",
  "version": "1.2.0",
  "description": "Automatic screen time tracking, active distraction site blocking (Instagram, YouTube, Reddit), and strict focus lock for StudySync.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "StudySync Focus Companion",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "permissions": [
    "tabs",
    "storage",
    "notifications",
    "alarms",
    "idle",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["block.html", "block.css", "block.js", "icons/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
